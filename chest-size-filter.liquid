{% comment %}
  CHEST SIZE FILTER — The Phir Story

  A dual-handle range-slider section that filters products by chest size.
  Chest size is parsed from the `custom.measurements` product metafield,
  which stores strings like: "Chest: 38" | Hip: 40""

  HOW TO USE:
  1. Copy this file to your theme's /sections/ folder as chest-size-filter.liquid
  2. In the theme editor, add this section to your homepage (or any page)
  3. Pick the collection to filter (default: all)
  4. Ensure products have the custom.measurements metafield populated

  HOW IT WORKS:
  Products + their measurements metafield are rendered inline at page load
  as a JSON blob. The client-side JS parses the "Chest: NN" number from
  each product's measurements string, then filters live as the user slides.
  No Storefront API, no AJAX fetches, works on any theme.
{% endcomment %}

<style>
  #chest-filter-{{ section.id }} {
    --tps-red: {{ section.settings.accent_color }};
    --tps-bg: {{ section.settings.background_color }};
    --tps-text: {{ section.settings.text_color }};
    font-family: 'Figtree', 'Archivo', sans-serif;
    background: var(--tps-bg);
    padding: 32px 24px 24px;
    text-align: center;
  }

  #chest-filter-{{ section.id }} .cf-title {
    font-family: 'Archivo', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--tps-text);
    margin: 0 0 8px;
  }

  #chest-filter-{{ section.id }} .cf-subtitle {
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    color: #888;
    margin: 0 0 20px;
  }

  #chest-filter-{{ section.id }} .cf-slider-wrap {
    max-width: 480px;
    margin: 0 auto;
    position: relative;
    padding: 0 8px;
  }

  #chest-filter-{{ section.id }} .cf-range-track {
    position: relative;
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
    margin: 24px 0 12px;
  }

  #chest-filter-{{ section.id }} .cf-range-fill {
    position: absolute;
    height: 100%;
    background: var(--tps-red);
    border-radius: 3px;
    top: 0;
  }

  #chest-filter-{{ section.id }} .cf-range-input {
    position: absolute;
    top: -10px;
    width: 100%;
    height: 26px;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    margin: 0;
  }

  #chest-filter-{{ section.id }} .cf-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--tps-red);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    cursor: pointer;
    pointer-events: all;
  }

  #chest-filter-{{ section.id }} .cf-range-input::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--tps-red);
    border: 3px solid #fff;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
    cursor: pointer;
    pointer-events: all;
  }

  #chest-filter-{{ section.id }} .cf-labels {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--tps-text);
    font-weight: 600;
    margin-top: 4px;
  }

  #chest-filter-{{ section.id }} .cf-value-display {
    font-family: 'Archivo', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--tps-text);
    margin: 0 0 4px;
    letter-spacing: -0.5px;
  }

  #chest-filter-{{ section.id }} .cf-value-display span {
    color: var(--tps-red);
  }

  #chest-filter-{{ section.id }} .cf-result-count {
    font-size: 13px;
    color: #888;
    margin-top: 12px;
    font-weight: 500;
  }

  #chest-filter-{{ section.id }} .cf-result-count strong {
    color: var(--tps-text);
    font-weight: 700;
  }

  #chest-filter-{{ section.id }} .cf-results {
    max-width: 1200px;
    margin: 28px auto 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
  }

  #chest-filter-{{ section.id }} .cf-product-card {
    text-align: center;
    text-decoration: none;
    color: var(--tps-text);
    display: block;
  }

  #chest-filter-{{ section.id }} .cf-product-card img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 2px;
    margin-bottom: 8px;
    transition: opacity 0.2s;
  }

  #chest-filter-{{ section.id }} .cf-product-card:hover img {
    opacity: 0.85;
  }

  #chest-filter-{{ section.id }} .cf-product-card .cf-p-title {
    font-family: 'Archivo', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0 0 4px;
  }

  #chest-filter-{{ section.id }} .cf-product-card .cf-p-price {
    font-size: 14px;
    color: var(--tps-red);
    font-weight: 600;
  }

  #chest-filter-{{ section.id }} .cf-product-card .cf-p-chest {
    font-size: 11px;
    color: #999;
    margin-top: 2px;
    letter-spacing: 0.5px;
  }

  #chest-filter-{{ section.id }} .cf-no-results {
    font-size: 14px;
    color: #888;
    padding: 40px 20px;
    display: none;
  }

  @media (max-width: 600px) {
    #chest-filter-{{ section.id }} .cf-results {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    #chest-filter-{{ section.id }} .cf-value-display {
      font-size: 18px;
    }
  }
</style>

<div id="chest-filter-{{ section.id }}">
  <p class="cf-title">{{ section.settings.heading }}</p>
  <p class="cf-subtitle">{{ section.settings.subheading }}</p>

  <div class="cf-value-display">
    <span id="cf-min-val-{{ section.id }}">{{ section.settings.min_size }}</span>
    &nbsp;—&nbsp;
    <span id="cf-max-val-{{ section.id }}">{{ section.settings.max_size }}</span>
    <span style="font-size: 13px; font-weight: 400; color: #888;"> inches</span>
  </div>

  <div class="cf-slider-wrap">
    <div class="cf-range-track">
      <div class="cf-range-fill" id="cf-fill-{{ section.id }}"></div>
    </div>
    <input
      type="range"
      class="cf-range-input"
      id="cf-range-min-{{ section.id }}"
      min="{{ section.settings.min_size }}"
      max="{{ section.settings.max_size }}"
      value="{{ section.settings.min_size }}"
      step="1"
    >
    <input
      type="range"
      class="cf-range-input"
      id="cf-range-max-{{ section.id }}"
      min="{{ section.settings.min_size }}"
      max="{{ section.settings.max_size }}"
      value="{{ section.settings.max_size }}"
      step="1"
    >
    <div class="cf-labels">
      <span>{{ section.settings.min_size }}"</span>
      <span>{{ section.settings.max_size }}"</span>
    </div>
  </div>

  <p class="cf-result-count" id="cf-count-{{ section.id }}"></p>

  <div class="cf-results" id="cf-results-{{ section.id }}"></div>
  <p class="cf-no-results" id="cf-no-results-{{ section.id }}">
    No pieces fit that range. Try widening the slider.
  </p>
</div>

{% comment %}
  Render product data inline as JSON. Liquid reads custom.measurements
  server-side — no AJAX/Storefront API needed.
{% endcomment %}
{%- assign coll_handle = section.settings.collection | default: 'all' -%}
{%- assign source_collection = collections[coll_handle] -%}
<script id="cf-data-{{ section.id }}" type="application/json">
[
  {%- for product in source_collection.products limit: 250 -%}
    {%- assign measurements = product.metafields.custom.measurements | default: '' -%}
    {%- assign fallback_measurements = product.metafields.custom.chest_size | default: '' -%}
    {
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 500 | json }},
      "price": {{ product.price | money | json }},
      "measurements": {{ measurements | json }},
      "chestFallback": {{ fallback_measurements | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

<script>
(function() {
  var sid = '{{ section.id }}';
  var minSlider = document.getElementById('cf-range-min-' + sid);
  var maxSlider = document.getElementById('cf-range-max-' + sid);
  var minDisplay = document.getElementById('cf-min-val-' + sid);
  var maxDisplay = document.getElementById('cf-max-val-' + sid);
  var fill = document.getElementById('cf-fill-' + sid);
  var resultsEl = document.getElementById('cf-results-' + sid);
  var noResultsEl = document.getElementById('cf-no-results-' + sid);
  var countEl = document.getElementById('cf-count-' + sid);
  var dataEl = document.getElementById('cf-data-' + sid);

  var MIN = parseInt(minSlider.min, 10);
  var MAX = parseInt(minSlider.max, 10);

  // Parse the inline JSON blob and extract chest size from each product's
  // measurements string (e.g. "Chest: 38" | Hip: 40"" -> 38).
  var products = [];
  try {
    var raw = JSON.parse(dataEl.textContent);
    raw.forEach(function(p) {
      var chest = extractChest(p.measurements) || extractChest(p.chestFallback);
      if (chest !== null) {
        products.push({
          handle: p.handle,
          title: p.title,
          image: p.image,
          price: p.price,
          chest: chest
        });
      }
    });
  } catch (e) {
    console.error('Chest filter: failed to parse product data', e);
  }

  function extractChest(str) {
    if (!str) return null;
    // Match "Chest: 38", "Chest: 24.5", "chest: 38 in", "Chest 38\"", bare number
    var m = str.match(/chest\s*[:\-]?\s*(\d{1,3}(?:\.\d+)?)/i);
    if (m) return parseFloat(m[1]);
    var bare = str.match(/^\s*(\d{1,3}(?:\.\d+)?)\s*$/);
    return bare ? parseFloat(bare[1]) : null;
  }

  function updateFill() {
    var minVal = parseInt(minSlider.value, 10);
    var maxVal = parseInt(maxSlider.value, 10);
    var range = MAX - MIN;
    var leftPct = ((minVal - MIN) / range) * 100;
    var rightPct = ((maxVal - MIN) / range) * 100;
    fill.style.left = leftPct + '%';
    fill.style.width = (rightPct - leftPct) + '%';
    minDisplay.textContent = minVal;
    maxDisplay.textContent = maxVal;
  }

  function render() {
    var minVal = parseInt(minSlider.value, 10);
    var maxVal = parseInt(maxSlider.value, 10);

    var matched = products.filter(function(p) {
      return p.chest >= minVal && p.chest <= maxVal;
    });

    resultsEl.innerHTML = '';
    if (matched.length === 0) {
      noResultsEl.style.display = 'block';
      countEl.innerHTML = '<strong>0</strong> pieces';
    } else {
      noResultsEl.style.display = 'none';
      countEl.innerHTML = '<strong>' + matched.length + '</strong> piece' + (matched.length === 1 ? '' : 's') + ' fit';
      var frag = document.createDocumentFragment();
      matched.forEach(function(p) {
        var card = document.createElement('a');
        card.className = 'cf-product-card';
        card.href = '/products/' + p.handle;
        card.innerHTML =
          '<img src="' + p.image + '" alt="' + p.title.replace(/"/g, '&quot;') + '" loading="lazy">' +
          '<p class="cf-p-title">' + p.title + '</p>' +
          '<p class="cf-p-price">' + p.price + '</p>' +
          '<p class="cf-p-chest">Chest ' + (p.chest % 1 === 0 ? p.chest : p.chest.toFixed(1)) + '"</p>';
        frag.appendChild(card);
      });
      resultsEl.appendChild(frag);
    }
  }

  minSlider.addEventListener('input', function() {
    if (parseInt(minSlider.value, 10) >= parseInt(maxSlider.value, 10)) {
      minSlider.value = parseInt(maxSlider.value, 10) - 1;
    }
    updateFill();
    render();
  });

  maxSlider.addEventListener('input', function() {
    if (parseInt(maxSlider.value, 10) <= parseInt(minSlider.value, 10)) {
      maxSlider.value = parseInt(minSlider.value, 10) + 1;
    }
    updateFill();
    render();
  });

  updateFill();
  render();
})();
</script>

{% schema %}
{
  "name": "Chest Size Filter",
  "tag": "section",
  "class": "chest-size-filter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Fit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Slide to your chest size and discover pieces that fit perfectly"
    },
    {
      "type": "range",
      "id": "min_size",
      "label": "Minimum chest size (inches)",
      "min": 28,
      "max": 50,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "max_size",
      "label": "Maximum chest size (inches)",
      "min": 28,
      "max": 56,
      "step": 1,
      "default": 46
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Source collection",
      "info": "Products from this collection will be available to filter. Use 'All products' for the whole store."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#C41E3A"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    }
  ],
  "presets": [
    {
      "name": "Chest Size Filter",
      "category": "Custom"
    }
  ]
}
{% endschema %}
